const DraggableSubtitleTrack = memo<DraggableSubtitleTrackProps>(
  ({
    track,
    trackLabel,
    text,
    fontSizePx,
    lineHeight,
    color,
    fontFamily,
    direction,
    lang,
    extraClassName = "",
    position,
    outlineShadow,
    bgStyle,
    backgroundMode,
    safeRect,
    onUpdatePosition,
  }) => {
    const boxRef = useRef<HTMLDivElement>(null);
    const [dragState, setDragState] = useState<{
      active: boolean;
      horizontalPercent: number;
      verticalPercent: number;
    } | null>(null);

    const dragSessionRef = useRef<{
      pointerId: number;
      startClientX: number;
      startClientY: number;
      startH: number;
      startV: number;
      boxWidth: number;
      boxHeight: number;
      lastCommittedH: number;
      lastCommittedV: number;
    } | null>(null);

    const isDraggable = Boolean(position.dragEnabled && onUpdatePosition);
    const activeH = dragState ? dragState.horizontalPercent : position.horizontalPercent;
    const activeV = dragState ? dragState.verticalPercent : position.verticalPercent;
    const textAlign = resolveTrackTextAlign({
      ...position,
      horizontalPercent: activeH,
      verticalPercent: activeV,
    });

    const handlePointerDown = (e: React.PointerEvent<HTMLDivElement>) => {
      if (!isDraggable || !e.isPrimary) return;
      if (e.pointerType === "mouse" && e.button !== 0) return;

      e.stopPropagation();
      const boxEl = boxRef.current;
      const boxRect = boxEl?.getBoundingClientRect();

      dragSessionRef.current = {
        pointerId: e.pointerId,
        startClientX: e.clientX,
        startClientY: e.clientY,
        startH: position.horizontalPercent,
        startV: position.verticalPercent,
        boxWidth: boxRect?.width ?? 160,
        boxHeight: boxRect?.height ?? 36,
        lastCommittedH: position.horizontalPercent,
        lastCommittedV: position.verticalPercent,
      };

      setDragState({
        active: true,
        horizontalPercent: position.horizontalPercent,
        verticalPercent: position.verticalPercent,
      });

      try {
        e.currentTarget.setPointerCapture(e.pointerId);
      } catch {
        // Ignore if pointer capture is unavailable
      }
    };

    const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
      const session = dragSessionRef.current;
      if (!session || e.pointerId !== session.pointerId) return;
      e.stopPropagation();

      const dx = e.clientX - session.startClientX;
      const dy = e.clientY - session.startClientY;

      const { horizontalPercent, verticalPercent } = computeDraggedTrackPercents({
        startHorizontalPercent: session.startH,
        startVerticalPercent: session.startV,
        dx,
        dy,
        safeWidth: safeRect.width,
        safeHeight: safeRect.height,
        boxWidth: session.boxWidth,
        boxHeight: session.boxHeight,
      });

      setDragState({
        active: true,
        horizontalPercent,
        verticalPercent,
      });

      if (
        onUpdatePosition &&
        (horizontalPercent !== session.lastCommittedH ||
          verticalPercent !== session.lastCommittedV)
      ) {
        session.lastCommittedH = horizontalPercent;
        session.lastCommittedV = verticalPercent;
        onUpdatePosition(track, {
          ...position,
          verticalPreset: "custom",
          verticalPercent,
          horizontalMode: "custom",
          horizontalPercent,
        });
      }
    };

    const finishDrag = (e: React.PointerEvent<HTMLDivElement>) => {
      const session = dragSessionRef.current;
      if (!session || e.pointerId !== session.pointerId) return;
      e.stopPropagation();
      dragSessionRef.current = null;
      setDragState(null);
      try {
        if (e.currentTarget.hasPointerCapture(e.pointerId)) {
          e.currentTarget.releasePointerCapture(e.pointerId);
        }
      } catch {
        // Ignore
      }
    };

    const showBadgeBelow = activeV < 18;

    return (
      <div
        ref={boxRef}
        data-no-gesture={isDraggable ? "true" : undefined}
        data-subtitle-track-box={track}
        onPointerDown={handlePointerDown}
        onPointerMove={handlePointerMove}
        onPointerUp={finishDrag}
        onPointerCancel={finishDrag}
        onTouchStart={isDraggable ? (e) => e.stopPropagation() : undefined}
        onMouseDown={isDraggable ? (e) => e.stopPropagation() : undefined}
        title={isDraggable ? `Drag to reposition ${trackLabel} subtitle` : undefined}
        style={{
          ...bgStyle,
          left: `${activeH}%`,
          top: `${activeV}%`,
          transform: `translate(-${activeH}%, -${activeV}%)`,
          maxWidth: "92%",
          maxHeight: "90%",
        }}
        className={`absolute w-max overflow-visible rounded-xl transition-shadow ${
          backgroundMode !== "none"
            ? "px-3 py-1.5 sm:px-3.5 sm:py-2"
            : "px-2 py-1"
        } ${
          isDraggable
            ? "pointer-events-auto touch-none select-none cursor-grab active:cursor-grabbing"
            : "pointer-events-none"
        } ${
          dragState?.active
            ? "z-20 ring-2 ring-teal-400/95 border border-dashed border-teal-200/90 shadow-lg"
            : "z-10"
        }`}
      >
        {dragState?.active && (
          <div
            className={`pointer-events-none absolute left-1/2 -translate-x-1/2 ${
              showBadgeBelow ? "top-full mt-1.5" : "bottom-full mb-1.5"
            } px-2 py-0.5 rounded-md bg-slate-950/95 border border-teal-400/50 text-[10px] font-mono-tabular font-semibold text-teal-200 whitespace-nowrap shadow`}
          >
            {trackLabel} · V {activeV}% · H {activeH}%
          </div>
        )}

        <p
          dir={direction}
          lang={lang}
          data-subtitle-track={track}
          style={{
            color,
            textShadow: outlineShadow,
            fontSize: `${fontSizePx}px`,
            lineHeight,
            fontFamily,
            textAlign,
          }}
          className={`font-semibold whitespace-normal break-words [overflow-wrap:anywhere] max-w-full m-0 ${extraClassName}`}
        >
          {text}
        </p>
      </div>
    );
  }
);

DraggableSubtitleTrack.displayName = "DraggableSubtitleTrack";

/**
 * Isolated memoized subtitle overlay rendering source and Bengali tracks independently
 * strictly inside the rendered video safe area.
 */
const SubtitleOverlay = memo<SubtitleOverlayProps>(
  ({
    segment,
    settings,
    sourceLanguageCode,
    sourceLanguageLabel,
    sourceDirection,
    safeRect,
    onUpdateSubtitlePosition,
  }) => {
    const outlineShadow = useMemo(() => {
      if (settings.outline === "none") return "none";
      if (settings.outline === "subtle") {
        return "0 1px 3px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,0.85)";
      }
      return "0 2px 4px rgba(0,0,0,0.98), -1px -1px 0 rgba(0,0,0,0.95), 1px -1px 0 rgba(0,0,0,0.95), -1px 1px 0 rgba(0,0,0,0.95), 1px 1px 0 rgba(0,0,0,0.95)";
    }, [settings.outline]);

    const bgStyle = useMemo<React.CSSProperties>(() => {
      if (settings.background === "none") {
        return { backgroundColor: "transparent" };
      }
      const alpha =
        settings.background === "solid"
          ? Math.max(0.88, settings.opacity / 100)
          : (settings.opacity / 100) * 0.72;
      return { backgroundColor: `rgba(10, 15, 28, ${alpha})` };
    }, [settings.background, settings.opacity]);

    if (!segment) return null;
    const showSource = settings.showSource && Boolean(segment.sourceText.trim());
    const showTarget = settings.showTarget && Boolean(segment.targetText.trim());
    if (!showSource && !showTarget) return null;

    const sourceFontPx = resolveSubtitleFontSizePx(
      settings.sourceFontSize,
      settings.sourceCustomFontSize
    );
    const targetFontPx = resolveSubtitleFontSizePx(
      settings.targetFontSize,
      settings.targetCustomFontSize
    );
    const sourceTypography = resolveSourceTypography(
      sourceLanguageCode,
      segment.sourceText,
      sourceDirection
    );

    return (
      <div
        aria-live="off"
        style={{
          left: `${safeRect.left}px`,
          top: `${safeRect.top}px`,
          width: `${safeRect.width}px`,
          height: `${safeRect.height}px`,
        }}
        className="pointer-events-none absolute z-10 overflow-hidden"
      >
        {showSource && (
          <DraggableSubtitleTrack
            track="source"
            trackLabel={sourceLanguageLabel}
            text={segment.sourceText}
            fontSizePx={sourceFontPx}
            lineHeight={1.4}
            color={settings.sourceColor}
            fontFamily={sourceTypography.fontFamily}
            direction={sourceTypography.direction}
            lang={sourceLanguageCode}
            extraClassName="tracking-tight"
            position={settings.sourcePosition}
            outlineShadow={outlineShadow}
            bgStyle={bgStyle}
            backgroundMode={settings.background}
            safeRect={safeRect}
            onUpdatePosition={onUpdateSubtitlePosition}
          />
        )}

        {showTarget && (
          <DraggableSubtitleTrack
            track="target"
            trackLabel="বাংলা"
            text={segment.targetText}
            fontSizePx={targetFontPx}
            lineHeight={1.45}
            color={settings.targetColor}
            fontFamily="var(--font-bengali)"
            direction="ltr"
            lang="bn"
            extraClassName="font-bengali"
            position={settings.targetPosition}
            outlineShadow={outlineShadow}
            bgStyle={bgStyle}
            backgroundMode={settings.background}
            safeRect={safeRect}
            onUpdatePosition={onUpdateSubtitlePosition}
          />
        )}
      </div>
    );
  }
);

SubtitleOverlay.displayName = "SubtitleOverlay";

function formatSignedDelta(deltaSeconds: number): string {
  const rounded = Math.round(deltaSeconds);
  const sign = rounded >= 0 ? "+" : "-";
  return `${sign}${formatClockTime(Math.abs(rounded))}`;
}

export const VideoPlayer = memo(
  forwardRef<VideoPlayerHandle, VideoPlayerProps>(
    (
      {
        videoUrl,
        videoTitle,
        segments,
        settings,
        playerSettings,
        sourceLanguageCode = "en",
        sourceLanguageLabel = "Source",
        sourceDirection = "ltr",
        playbackRate,
        volume,
        isMuted,
        onChangeVolume,
        onToggleMute,
        onTimeUpdate,
        onActiveSegmentChange,
        onDurationChange,
        onPlayStateChange,
        onFullscreenChange,
        seekRequestTime,
        onSeekHandled,
        onUpdateSubtitlePosition,
        onOpenSettings,
        onOpenMobileSubtitles,
        onOpenMobileExport,
        onBackHome,
        settingsOpen = false,
        isProcessing = false,
        processingProgress = 0,
        overlaySlot,
      },
      ref
    ) => {
      const containerRef = useRef<HTMLDivElement>(null);
      const stageRef = useRef<HTMLDivElement>(null);
      const videoRef = useRef<HTMLVideoElement>(null);
      const lastNotifyRef = useRef<number>(0);
      const lastActiveIdRef = useRef<string | null>(null);
      const hideControlsTimerRef = useRef<number | null>(null);
      const floatingHideTimerRef = useRef<number | null>(null);
      const singleTapTimerRef = useRef<number | null>(null);
      const doubleTapTimerRef = useRef<number | null>(null);

      const [localTime, setLocalTime] = useState(0);
      const [isPlaying, setIsPlaying] = useState(false);
      const [duration, setDuration] = useState(0);
      const [isFullscreen, setIsFullscreen] = useState(false);
      const [isMobileViewport, setIsMobileViewport] = useState(() =>
        typeof window !== "undefined"
          ? window.innerWidth < 768 ||
            (window.innerWidth < 1024 && window.innerHeight <= 500)
          : false
      );
      const [controlsVisible, setControlsVisible] = useState(true);
      const [floatingOverlayVisible, setFloatingOverlayVisible] =
        useState(false);
      const [isInteractingControls, setIsInteractingControls] = useState(false);

    const [swipePreview, setSwipePreview] = useState<SwipePreviewState | null>(
      null
    );
    const [doubleTapFeedback, setDoubleTapFeedback] =
      useState<DoubleTapFeedback | null>(null);
    const [stageSize, setStageSize] = useState<Dimensions>({
      width: 640,
      height: 360,
    });
    const [videoNaturalSize, setVideoNaturalSize] = useState<Dimensions | null>(
      null
    );

    const quickSeekSeconds = useMemo(
      () => resolveQuickSeekSeconds(playerSettings),
      [playerSettings]
    );
    const swipeSecondsPer100Px = useMemo(
      () => resolveSwipeSecondsPer100Px(playerSettings),
      [playerSettings]
    );

    const playerConfigRef = useRef({
      duration: 0,
      localTime: 0,
      quickSeekSeconds,
      swipeSecondsPer100Px,
      horizontalSwipeEnabled: playerSettings.horizontalSwipeEnabled,
      doubleTapSeekEnabled: playerSettings.doubleTapSeekEnabled,
      floatingButtonsMode: playerSettings.floatingButtonsMode,
    });
    playerConfigRef.current = {
      duration,
      localTime,
      quickSeekSeconds,
      swipeSecondsPer100Px,
      horizontalSwipeEnabled: playerSettings.horizontalSwipeEnabled,
      doubleTapSeekEnabled: playerSettings.doubleTapSeekEnabled,
      floatingButtonsMode: playerSettings.floatingButtonsMode,
    };

    const gestureRef = useRef<{
      active: boolean;
      inputType: "touch" | "mouse" | null;
      startX: number;
      startY: number;
      startTime: number;
      mode: "undecided" | "horizontal-seek" | "vertical-scroll";
      previewTime: number;
    }>({
      active: false,
      inputType: null,
      startX: 0,
      startY: 0,
      startTime: 0,
      mode: "undecided",
      previewTime: 0,
    });

    const tapTrackerRef = useRef<{
      lastTapTime: number;
      lastZone: "left" | "center" | "right" | null;
      accumulatedDelta: number;
    }>({
      lastTapTime: 0,
      lastZone: null,
      accumulatedDelta: 0,
    });

    const activeSegment = useMemo(
      () =>
        findActiveSegmentBinary(
          segments,
          swipePreview ? swipePreview.previewTime : localTime
        ),
      [segments, localTime, swipePreview]
    );

    const autoHideDelayMs = playerSettings.autoHideDelayMs ?? 2500;

    const scheduleAutoHide = useCallback(() => {
      if (hideControlsTimerRef.current !== null) {
        window.clearTimeout(hideControlsTimerRef.current);
      }
      if (
        !playerSettings.autoHideControls ||
        !isPlaying ||
        isInteractingControls ||
        settingsOpen
      ) {
        return;
      }
      hideControlsTimerRef.current = window.setTimeout(() => {
        setControlsVisible(false);
      }, autoHideDelayMs);
    }, [
      playerSettings.autoHideControls,
      autoHideDelayMs,
      isPlaying,
      isInteractingControls,
      settingsOpen,
    ]);

    const clearFloatingHideTimer = useCallback(() => {
      if (floatingHideTimerRef.current !== null) {
        window.clearTimeout(floatingHideTimerRef.current);
        floatingHideTimerRef.current = null;
      }
    }, []);

    const scheduleFloatingAutoHide = useCallback(() => {
      clearFloatingHideTimer();
      floatingHideTimerRef.current = window.setTimeout(() => {
        setFloatingOverlayVisible(false);
        floatingHideTimerRef.current = null;
      }, 2500);
    }, [clearFloatingHideTimer]);

    const revealControls = useCallback(() => {
      setControlsVisible(true);
      scheduleAutoHide();
    }, [scheduleAutoHide]);

    useEffect(() => {
      if (
        !playerSettings.autoHideControls ||
        !isPlaying ||
        isInteractingControls ||
        settingsOpen
      ) {
        if (hideControlsTimerRef.current !== null) {
          window.clearTimeout(hideControlsTimerRef.current);
        }
        setControlsVisible(true);
      } else {
        scheduleAutoHide();
      }
      return () => {
        if (hideControlsTimerRef.current !== null) {
          window.clearTimeout(hideControlsTimerRef.current);
        }
      };
    }, [
      playerSettings.autoHideControls,
      isPlaying,
      isInteractingControls,
      settingsOpen,
      scheduleAutoHide,
    ]);

    // Ensure floating buttons start hidden when video changes or visibility mode changes
    useEffect(() => {
      clearFloatingHideTimer();
      setFloatingOverlayVisible(false);
    }, [videoUrl, playerSettings.floatingButtonsMode, clearFloatingHideTimer]);

    // Measure rendered video stage dimensions continuously for safe subtitle bounds
    useEffect(() => {
      const stage = stageRef.current;
      if (!stage) return;

      const updateSize = () => {
        const rect = stage.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          setStageSize({ width: rect.width, height: rect.height });
        }
      };

      updateSize();

      if (typeof ResizeObserver !== "undefined") {
        const observer = new ResizeObserver(() => updateSize());
        observer.observe(stage);
        return () => observer.disconnect();
      }
      window.addEventListener("resize", updateSize);
      return () => window.removeEventListener("resize", updateSize);
    }, []);

    // Reset playback state immediately when switching to a newly selected local video
    useEffect(() => {
      setLocalTime(0);
      setIsPlaying(false);
      setDuration(0);
      setVideoNaturalSize(null);
      setSwipePreview(null);
      setDoubleTapFeedback(null);
      setControlsVisible(true);
      setFloatingOverlayVisible(false);
      lastActiveIdRef.current = null;
      lastNotifyRef.current = 0;
      onTimeUpdate(0);
    }, [videoUrl, onTimeUpdate]);

    // Notify parent ONLY when active segment ID actually changes
    useEffect(() => {
      const nextId = activeSegment?.id ?? null;
      if (nextId !== lastActiveIdRef.current) {
        lastActiveIdRef.current = nextId;
        onActiveSegmentChange?.(nextId);
      }
    }, [activeSegment?.id, onActiveSegmentChange]);

    // Sync external seek requests (e.g. clicking a segment in Subtitle Editor)
    useEffect(() => {
      if (seekRequestTime !== null && videoRef.current) {
        const clamped = Math.max(
          0,
          duration > 0 ? Math.min(duration, seekRequestTime) : seekRequestTime
        );
        videoRef.current.currentTime = clamped;
        setLocalTime(clamped);
        onTimeUpdate(clamped);
        onSeekHandled();
      }
    }, [seekRequestTime, duration, onSeekHandled, onTimeUpdate]);

    // Track mobile (portrait + Android landscape) vs desktop viewport for responsive MX Player full-screen mode
    useEffect(() => {
      const checkViewport = () => {
        setIsMobileViewport(
          window.innerWidth < 768 ||
            (window.innerWidth < 1024 && window.innerHeight <= 500)
        );
      };
      checkViewport();
      window.addEventListener("resize", checkViewport);
      return () => window.removeEventListener("resize", checkViewport);
    }, []);

    // Sync controlled playbackRate, volume, and muted state to the video element
    useEffect(() => {
      if (videoRef.current) {
        videoRef.current.playbackRate = playbackRate;
      }
    }, [playbackRate]);

    useEffect(() => {
      if (videoRef.current) {
        videoRef.current.volume = volume;
        videoRef.current.muted = isMuted;
      }
    }, [volume, isMuted]);

    useEffect(() => {
      const onFsChange = () => {
        const fs = Boolean(document.fullscreenElement);
        setIsFullscreen(fs);
        onFullscreenChange?.(fs);
        if (!fs) {
          try {
            const orientation = screen.orientation as
              | (ScreenOrientation & { unlock?: () => void })
              | undefined;
            orientation?.unlock?.();
          } catch {
            // Ignore orientation unlock errors
          }
        }
      };
      document.addEventListener("fullscreenchange", onFsChange);
      return () => document.removeEventListener("fullscreenchange", onFsChange);
    }, [onFullscreenChange]);

    // Smooth local timeline + subtitle sync while throttling parent time updates to 4Hz
    useEffect(() => {
      let rafId = 0;
      const syncTick = () => {
        const video = videoRef.current;
        if (video && !video.paused) {
          const t = video.currentTime;
          setLocalTime(t);
          const now = performance.now();
          if (now - lastNotifyRef.current >= 250) {
            lastNotifyRef.current = now;
            onTimeUpdate(t);
          }
          rafId = requestAnimationFrame(syncTick);
        }
      };
      if (isPlaying) {
        rafId = requestAnimationFrame(syncTick);
      }
      return () => cancelAnimationFrame(rafId);
    }, [isPlaying, onTimeUpdate]);

    const handleSeek = useCallback(
      (newTime: number) => {
        const video = videoRef.current;
        const maxDur =
          video && Number.isFinite(video.duration) && video.duration > 0
            ? video.duration
            : playerConfigRef.current.duration;
        const clamped = Math.max(0, maxDur > 0 ? Math.min(maxDur, newTime) : 0);
        if (video) {
          video.currentTime = clamped;
        }
        setLocalTime(clamped);
        onTimeUpdate(clamped);
      },
      [onTimeUpdate]
    );

    const handleQuickSeekDelta = useCallback(
      (deltaSeconds: number) => {
        const video = videoRef.current;
        const base = video ? video.currentTime : playerConfigRef.current.localTime;
        handleSeek(base + deltaSeconds);
        revealControls();
      },
      [handleSeek, revealControls]
    );

    const togglePlay = useCallback(() => {
      const video = videoRef.current;
      if (!video) return;
      if (video.paused) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
      revealControls();
    }, [revealControls]);

    const handlePrevious = () => {
      const prev = [...segments]
        .reverse()
        .find((seg) => seg.startTime < localTime - 0.8);
      if (prev) {
        handleSeek(prev.startTime);
      } else {
        handleSeek(localTime - quickSeekSeconds);
      }
      revealControls();
    };

    const handleNext = () => {
      const next = segments.find((seg) => seg.startTime > localTime + 0.3);
      if (next) {
        handleSeek(next.startTime);
      } else {
        handleSeek(localTime + quickSeekSeconds);
      }
      revealControls();
    };

    const toggleFullscreen = useCallback(async () => {
      if (!containerRef.current) return;
      try {
        if (!document.fullscreenElement) {
          await containerRef.current.requestFullscreen();
          if (playerSettings.autoLandscapeFullscreen) {
            try {
              const orientation = screen.orientation as
                | (ScreenOrientation & { lock?: (mode: string) => Promise<void> })
                | undefined;
              await orientation?.lock?.("landscape");
            } catch {
              // Ignore unsupported browser orientation lock
            }
          }
        } else {
          await document.exitFullscreen();
        }
      } catch {
        // Ignore fullscreen denial on unsupported browsers
      }
    }, [playerSettings.autoLandscapeFullscreen]);

    useImperativeHandle(
      ref,
      () => ({
        togglePlay,
        pause: () => {
          if (videoRef.current && !videoRef.current.paused) {
            videoRef.current.pause();
          }
        },
        toggleFullscreen: () => {
          void toggleFullscreen();
        },
      }),
      [togglePlay, toggleFullscreen]
    );

    const handleVolumeChange = (val: number) => {
      onChangeVolume(val);
    };

    // Unified tap handler supporting MX Player double-tap seek on left/right zones + single-tap controls & floating button toggle
    const processStageTap = useCallback(
      (clientX: number) => {
        const stage = stageRef.current;
        if (!stage) return;
        const rect = stage.getBoundingClientRect();
        const relX = rect.width > 0 ? (clientX - rect.left) / rect.width : 0.5;
        const zone: "left" | "center" | "right" =
          relX < 0.38 ? "left" : relX > 0.62 ? "right" : "center";

        const cfg = playerConfigRef.current;
        const canDoubleTapSeek =
          cfg.doubleTapSeekEnabled &&
          cfg.duration > 0 &&
          (zone === "left" || zone === "right");

        const handleSingleTapToggle = () => {
          setControlsVisible((prev) => {
            const next = !prev;
            if (next) scheduleAutoHide();
            return next;
          });
          if (playerConfigRef.current.floatingButtonsMode === "show_on_tap") {
            setFloatingOverlayVisible((prev) => {
              const next = !prev;
              if (next) {
                scheduleFloatingAutoHide();
              } else {
                clearFloatingHideTimer();
              }
              return next;
            });
          }
        };

        if (!canDoubleTapSeek) {
          handleSingleTapToggle();
          return;
        }

        const now = performance.now();
        const tracker = tapTrackerRef.current;

        if (
          tracker.lastZone === zone &&
          now - tracker.lastTapTime <= 280
        ) {
          if (singleTapTimerRef.current !== null) {
            window.clearTimeout(singleTapTimerRef.current);
            singleTapTimerRef.current = null;
          }
          tracker.lastTapTime = now;
          const step =
            zone === "right" ? cfg.quickSeekSeconds : -cfg.quickSeekSeconds;
          tracker.accumulatedDelta += step;
          handleQuickSeekDelta(step);

          setDoubleTapFeedback({
            side: zone,
            totalDeltaSeconds: tracker.accumulatedDelta,
          });
          if (doubleTapTimerRef.current !== null) {
            window.clearTimeout(doubleTapTimerRef.current);
          }
          doubleTapTimerRef.current = window.setTimeout(() => {
            setDoubleTapFeedback(null);
            tapTrackerRef.current.accumulatedDelta = 0;
            tapTrackerRef.current.lastZone = null;
          }, 750);
          return;
        }

        tracker.lastTapTime = now;
        tracker.lastZone = zone;
        tracker.accumulatedDelta = 0;

        if (singleTapTimerRef.current !== null) {
          window.clearTimeout(singleTapTimerRef.current);
        }
        singleTapTimerRef.current = window.setTimeout(() => {
          singleTapTimerRef.current = null;
          handleSingleTapToggle();
        }, 250);
      },
      [
        clearFloatingHideTimer,
        handleQuickSeekDelta,
        scheduleAutoHide,
        scheduleFloatingAutoHide,
      ]
    );

    // Attach non-passive touch listeners + desktop mouse drag listeners on the video stage
    useEffect(() => {
      const stage = stageRef.current;
      if (!stage) return;

      const isInteractiveTarget = (target: EventTarget | null) => {
        if (!(target instanceof Element)) return false;
        return Boolean(
          target.closest(
            '[data-no-gesture="true"], button, input, select, textarea, a'
          )
        );
      };

      const startGesture = (
        inputType: "touch" | "mouse",
        x: number,
        y: number
      ) => {
        const video = videoRef.current;
        const startTime = video ? video.currentTime : playerConfigRef.current.localTime;
        gestureRef.current = {
          active: true,
          inputType,
          startX: x,
          startY: y,
          startTime,
          mode: "undecided",
          previewTime: startTime,
        };
      };

      const moveGesture = (x: number, y: number, cancelableTouchEvent?: TouchEvent) => {
        const g = gestureRef.current;
        if (!g.active) return;

        const dx = x - g.startX;
        const dy = y - g.startY;
        const absX = Math.abs(dx);
        const absY = Math.abs(dy);
        const cfg = playerConfigRef.current;

        if (g.mode === "undecided") {
          if (Math.hypot(dx, dy) < 14) return;
          if (
            absX > absY * 1.35 &&
            cfg.horizontalSwipeEnabled &&
            cfg.duration > 0
          ) {
            g.mode = "horizontal-seek";
          } else {
            g.mode = "vertical-scroll";
            return;
          }
        }

        if (g.mode !== "horizontal-seek") return;

        if (cancelableTouchEvent && cancelableTouchEvent.cancelable) {
          cancelableTouchEvent.preventDefault();
        }

        const rawDelta = (dx / 100) * cfg.swipeSecondsPer100Px;
        const nextPreview = Math.max(
          0,
          Math.min(cfg.duration, g.startTime + rawDelta)
        );
        g.previewTime = nextPreview;

        setSwipePreview({
          direction: dx >= 0 ? "forward" : "backward",
          deltaSeconds: nextPreview - g.startTime,
          startTime: g.startTime,
          previewTime: nextPreview,
        });
      };

      const endGesture = (clientX: number, cancelled: boolean) => {
        const g = gestureRef.current;
        if (!g.active) return;
        const mode = g.mode;
        const targetPreview = g.previewTime;
        g.active = false;
        g.inputType = null;
        g.mode = "undecided";

        if (cancelled) {
          setSwipePreview(null);
          return;
        }

        if (mode === "horizontal-seek") {
          setSwipePreview(null);
          handleSeek(targetPreview);
          revealControls();
        } else if (mode === "undecided") {
          processStageTap(clientX);
        }
      };

      const onTouchStart = (e: TouchEvent) => {
        if (e.touches.length !== 1 || isInteractiveTarget(e.target)) return;
        const t = e.touches[0];
        startGesture("touch", t.clientX, t.clientY);
      };

      const onTouchMove = (e: TouchEvent) => {
        if (gestureRef.current.inputType !== "touch" || e.touches.length !== 1) return;
        const t = e.touches[0];
        moveGesture(t.clientX, t.clientY, e);
      };

      const onTouchEnd = (e: TouchEvent) => {
        if (gestureRef.current.inputType !== "touch") return;
        const t = e.changedTouches[0];
        endGesture(t ? t.clientX : gestureRef.current.startX, false);
      };

      const onTouchCancel = () => {
        if (gestureRef.current.inputType !== "touch") return;
        endGesture(0, true);
      };

      const onMouseDown = (e: MouseEvent) => {
        if (e.button !== 0 || isInteractiveTarget(e.target)) return;
        startGesture("mouse", e.clientX, e.clientY);
      };

      const onWindowMouseMove = (e: MouseEvent) => {
        if (gestureRef.current.inputType !== "mouse") return;
        moveGesture(e.clientX, e.clientY);
      };

      const onWindowMouseUp = (e: MouseEvent) => {
        if (gestureRef.current.inputType !== "mouse") return;
        endGesture(e.clientX, false);
      };

      stage.addEventListener("touchstart", onTouchStart, { passive: true });
      stage.addEventListener("touchmove", onTouchMove, { passive: false });
      stage.addEventListener("touchend", onTouchEnd, { passive: true });
      stage.addEventListener("touchcancel", onTouchCancel, { passive: true });
      stage.addEventListener("mousedown", onMouseDown);
      window.addEventListener("mousemove", onWindowMouseMove);
      window.addEventListener("mouseup", onWindowMouseUp);

      return () => {
        stage.removeEventListener("touchstart", onTouchStart);
        stage.removeEventListener("touchmove", onTouchMove);
        stage.removeEventListener("touchend", onTouchEnd);
        stage.removeEventListener("touchcancel", onTouchCancel);
        stage.removeEventListener("mousedown", onMouseDown);
        window.removeEventListener("mousemove", onWindowMouseMove);
        window.removeEventListener("mouseup", onWindowMouseUp);
      };
    }, [handleSeek, processStageTap, revealControls]);

