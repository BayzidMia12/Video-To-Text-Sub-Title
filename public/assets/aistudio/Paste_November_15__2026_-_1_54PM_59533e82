    const stageAspect = stageW / stageH;
    const videoAspect = videoNaturalSize.width / videoNaturalSize.height;

    if (videoAspect > stageAspect) {
      renderedW = stageW;
      renderedH = stageW / videoAspect;
      renderedTop = (stageH - renderedH) / 2;
    } else {
      renderedH = stageH;
      renderedW = stageH * videoAspect;
      renderedLeft = (stageW - renderedW) / 2;
    }
  }

  const sidePad = Math.max(8, Math.round(renderedW * 0.02));
  const topPad = 8;
  const baseBottomPad = 8;

  let bottomPad = baseBottomPad;
  const hasBottomOverlay = Boolean(
    (options?.isFullscreen || options?.controlsOverlayBottom) &&
      options?.controlsVisible
  );
  if (hasBottomOverlay) {
    const clearance = options?.fullscreenControlsClearancePx ?? 100;
    const videoBottomInStage = renderedTop + renderedH;
    const controlsTopInStage = Math.max(0, stageH - clearance);
    const overlap = Math.max(0, videoBottomInStage - controlsTopInStage);
    bottomPad = Math.max(baseBottomPad, Math.round(overlap));
  }

  // Always preserve at least a usable vertical lane inside short viewports
  const maxSafeBottomPad = Math.max(baseBottomPad, Math.floor(renderedH - topPad - 64));
  bottomPad = Math.min(bottomPad, maxSafeBottomPad);

  return {
    left: Math.round(renderedLeft + sidePad),
    top: Math.round(renderedTop + topPad),
    width: Math.max(80, Math.round(renderedW - sidePad * 2)),
    height: Math.max(60, Math.round(renderedH - topPad - bottomPad)),
  };
}

export function resolveTrackTextAlign(
  pos: SubtitleTrackPosition
): "left" | "center" | "right" {
  if (pos.horizontalMode === "left") return "left";
  if (pos.horizontalMode === "right") return "right";
  if (pos.horizontalMode === "center") return "center";
  if (pos.horizontalPercent < 28) return "left";
  if (pos.horizontalPercent > 72) return "right";
  return "center";
}

/**
 * Maps a pointer drag delta (dx, dy) 1:1 to percentage changes using the anchor formula:
 * `leftPx = (h% / 100) * (safeWidth - boxWidth)`
 */
export function computeDraggedTrackPercents(params: {
  startHorizontalPercent: number;
  startVerticalPercent: number;
  dx: number;
  dy: number;
  safeWidth: number;
  safeHeight: number;
  boxWidth: number;
  boxHeight: number;
}): { horizontalPercent: number; verticalPercent: number } {
  const effectiveW = Math.max(40, params.safeWidth - params.boxWidth);
  const effectiveH = Math.max(40, params.safeHeight - params.boxHeight);

  const rawH = params.startHorizontalPercent + (params.dx / effectiveW) * 100;
  const rawV = params.startVerticalPercent + (params.dy / effectiveH) * 100;

  return {
    horizontalPercent: clampPositionPercent(rawH, params.startHorizontalPercent),
    verticalPercent: clampPositionPercent(rawV, params.startVerticalPercent),
  };
}
