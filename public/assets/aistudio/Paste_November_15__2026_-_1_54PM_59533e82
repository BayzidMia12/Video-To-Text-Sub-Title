    const json = generateProjectJson(project);
    downloadTextFile(json, `${baseName}_subtitles.json`, "application/json");
  };

  const handleExportVideo = async () => {
    if (!videoUrl) return;
    setVideoExportError(null);
    setVideoExportProgress(0);
