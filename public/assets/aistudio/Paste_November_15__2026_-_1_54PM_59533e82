function resolveSourceTypography(
  languageCode: string,
  text: string,
  fallbackDir: "ltr" | "rtl"
): { fontFamily: string; direction: "ltr" | "rtl" } {
  const normalized = languageCode.toLowerCase().split("-")[0];
  if (normalized === "ar" || /[\u0600-\u06FF\u0750-\u077F]/.test(text)) {
    return { fontFamily: "var(--font-arabic)", direction: "rtl" };
  }
  if (normalized === "hi" || /[\u0900-\u097F]/.test(text)) {
    return { fontFamily: "var(--font-hindi)", direction: fallbackDir };
  }
  if (normalized === "ko" || /[\uAC00-\uD7AF\u1100-\u11FF]/.test(text)) {
    return { fontFamily: "var(--font-korean)", direction: fallbackDir };
  }
  if (normalized === "zh" || /[\u4E00-\u9FFF]/.test(text)) {
    return { fontFamily: "var(--font-chinese)", direction: fallbackDir };
  }
  if (normalized === "ta" || /[\u0B80-\u0BFF]/.test(text)) {
    return { fontFamily: "var(--font-tamil)", direction: fallbackDir };
  }
  return { fontFamily: "var(--font-sans)", direction: fallbackDir };
}

