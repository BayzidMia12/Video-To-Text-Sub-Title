        ))}

        <button
          type="button"
          aria-pressed={preset === "custom"}
          onClick={() => onSelectPreset("custom")}
          className={`min-h-[40px] px-1.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${
            preset === "custom"
              ? "bg-white dark:bg-slate-900 text-teal-700 dark:text-teal-300 font-semibold shadow-sm"
              : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200"
          }`}
        >
          Custom
        </button>
      </div>

      {preset === "custom" && (
        <div className="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/40 space-y-2">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <label
              htmlFor={`${idPrefix}-custom-px`}
              className="text-xs font-medium text-slate-700 dark:text-slate-300"
            >
              Custom size ({MIN_SUBTITLE_FONT_PX}px – {MAX_SUBTITLE_FONT_PX}px)
            </label>
            <div className="flex items-center gap-1.5">
              <input
                id={`${idPrefix}-custom-px`}
                type="number"
                inputMode="numeric"
                min={MIN_SUBTITLE_FONT_PX}
                max={MAX_SUBTITLE_FONT_PX}
                step={1}
                value={draftValue}
                onChange={(e) => {
                  const raw = e.target.value;
                  setDraftValue(raw);
                  const n = Number(raw);
                  if (
                    raw.trim() !== "" &&
                    Number.isFinite(n) &&
                    n >= MIN_SUBTITLE_FONT_PX &&
                    n <= MAX_SUBTITLE_FONT_PX
                  ) {
                    onChangeCustomPx(Math.round(n));
                  }
                }}
                onBlur={() => {
                  const clamped = clampCustomSubtitleFontPx(draftValue, customPx);
                  setDraftValue(String(clamped));
                  onChangeCustomPx(clamped);
                }}
                className="w-20 min-h-[36px] px-2.5 py-1 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-xs font-mono-tabular font-semibold text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-teal-500"
              />
              <span className="text-xs font-mono-tabular text-slate-500 dark:text-slate-400">
                px
              </span>
            </div>
          </div>

          <input
            aria-label={`${label} slider`}
            type="range"
            min={MIN_SUBTITLE_FONT_PX}
            max={MAX_SUBTITLE_FONT_PX}
            step={1}
            value={effectivePx}
            onChange={(e) => {
              const next = clampCustomSubtitleFontPx(e.target.value, effectivePx);
              setDraftValue(String(next));
              onChangeCustomPx(next);
            }}
            className="studio-range w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full"
          />

          {!isDraftValid && (
            <p className="text-[11px] text-amber-600 dark:text-amber-400">
              Enter a size between {MIN_SUBTITLE_FONT_PX}px and {MAX_SUBTITLE_FONT_PX}px.
            </p>
          )}
        </div>
      )}
    </div>
  );
};

interface TrackPositionEditorProps {
  idPrefix: string;
  title: string;
  trackKind: "target" | "source";
  position: SubtitleTrackPosition;
  resetLabel: string;
  onChangePosition: (next: SubtitleTrackPosition) => void;
  onResetTrack: () => void;
}

const TrackPositionEditor: React.FC<TrackPositionEditorProps> = ({
  idPrefix,
  title,
  trackKind,
  position,
  resetLabel,
  onChangePosition,
  onResetTrack,
}) => {
  const presetLabel =
    VERTICAL_PRESET_OPTIONS.find((p) => p.value === position.verticalPreset)
      ?.label ?? "Custom Position";

  const handleSelectVerticalPreset = (preset: SubtitleVerticalPreset) => {
    if (preset === "custom") {
      onChangePosition({
        ...position,
        verticalPreset: "custom",
      });
      return;
    }
    const defaultPct =
      preset === "bottom"
        ? trackKind === "source"
          ? DEFAULT_SOURCE_SUBTITLE_POSITION.verticalPercent
          : DEFAULT_TARGET_SUBTITLE_POSITION.verticalPercent
        : VERTICAL_PRESET_PERCENT_MAP[preset];

    onChangePosition({
      ...position,
      verticalPreset: preset,
      verticalPercent: defaultPct,
    });
  };

  const handleSelectHorizontalMode = (mode: SubtitleHorizontalMode) => {
    if (mode === "custom") {
      onChangePosition({
        ...position,
        horizontalMode: "custom",
      });
      return;
    }
    onChangePosition({
