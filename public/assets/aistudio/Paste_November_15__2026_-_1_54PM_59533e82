  const [editingId, setEditingId] = useState<string | null>(null);
  const [draftStart, setDraftStart] = useState("");
  const [draftEnd, setDraftEnd] = useState("");
  const [draftSource, setDraftSource] = useState("");
  const [draftTarget, setDraftTarget] = useState("");
  const [searchQuery, setSearchQuery] = useState("");
  const [timeError, setTimeError] = useState<string | null>(null);

  const startEditing = (seg: SubtitleSegment) => {
    setEditingId(seg.id);
    setDraftStart(formatFullTimestamp(seg.startTime));
    setDraftEnd(formatFullTimestamp(seg.endTime));
    setDraftSource(seg.sourceText);
    setDraftTarget(seg.targetText);
    setTimeError(null);
  };

  const cancelEditing = () => {
    setEditingId(null);
    setTimeError(null);
  };

  const handleSave = (seg: SubtitleSegment) => {
    const parsedStart = parseTimeInput(draftStart);
    const parsedEnd = parseTimeInput(draftEnd);

    if (parsedStart === null || parsedEnd === null || parsedEnd <= parsedStart) {
      setTimeError("End time must be after start time (e.g. 00:01:20).");
      return;
    }

    onUpdateSegment({
      ...seg,
      startTime: parsedStart,
      endTime: parsedEnd,
      sourceText: draftSource.trim(),
      targetText: draftTarget.trim(),
    });
    setEditingId(null);
    setTimeError(null);
